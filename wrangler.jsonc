{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local Phase 0 configuration. Remote environments require their own resource inventory.
  "name": "next-cloud-flare-local",
  "main": "packages/worker/src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ncf-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "packages/worker/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "ncf-local-blobs" },
    { "binding": "BACKUPS", "bucket_name": "ncf-local-backups" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlDO" },
      { "name": "LOCKS", "class_name": "LockDO" },
      { "name": "UPLOADS", "class_name": "UploadDO" },
      { "name": "BUDGETS", "class_name": "BudgetDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sqlite-do",
      "new_sqlite_classes": ["ControlDO", "LockDO", "UploadDO", "BudgetDO"]
    }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "ncf-local-jobs" }],
    "consumers": [
      {
        "queue": "ncf-local-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "ncf-local-jobs-dlq",
        "max_concurrency": 8
      }
    ]
  },
  "triggers": { "crons": ["* * * * *"] },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    {
      "name": "EDGE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "CONTENT_ORIGIN": "http://localhost:8788",
    "PBKDF2_ITERATIONS": "100000"
  }
}
