# Set the provisioned ControlDO epoch; blank fails before a backup request is sent.
NCF_BACKUP_EPOCH=
# Install the pinned repository Node version in the service's PATH.
PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin
CI=true
WRANGLER_SEND_METRICS=false
# Supply real credentials only in the host's protected EnvironmentFile, never in git.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_BACKUP_ACCOUNT_ID=
R2_BACKUP_BUCKET=
R2_BACKUP_JURISDICTION=default
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
