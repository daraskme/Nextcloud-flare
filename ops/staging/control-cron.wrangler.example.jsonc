{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ncf-staging-control-recovery",
  "main": "./control-cron.mjs",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "services": [
    {
      "binding": "STAGING_CONTROL",
      "service": "next-cloud-flare-staging",
      "entrypoint": "StagingControlOperator",
      "props": { "purpose": "staging-control-recovery-v1", "environment": "staging" }
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "STAGING_CONTROL_CRON_ENABLED": "true",
    "STAGING_TARGET": "next-cloud-flare-staging"
  }
}
