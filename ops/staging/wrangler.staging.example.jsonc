{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Review template only. Resource IDs are deliberately invalid until the staging inventory is approved.
  "name": "next-cloud-flare-staging",
  "main": "../../packages/worker/src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "routes": [
    { "pattern": "staging-app.darask.date", "custom_domain": true },
    { "pattern": "staging-content.darask.date", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../packages/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ncf-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_UUID",
      "migrations_dir": "../../packages/worker/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "ncf-staging-blobs" },
    { "binding": "BACKUPS", "bucket_name": "ncf-staging-backups" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "REPLACE_WITH_STAGING_KV_ID" }],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlDO" },
      { "name": "LOCKS", "class_name": "LockDO" },
      { "name": "UPLOADS", "class_name": "UploadDO" },
      { "name": "BUDGETS", "class_name": "BudgetDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sqlite-do",
      "new_sqlite_classes": ["ControlDO", "LockDO", "UploadDO", "BudgetDO"]
    }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "ncf-staging-jobs" }],
    "consumers": [
      {
        "queue": "ncf-staging-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "ncf-staging-jobs-dlq",
        "max_concurrency": 8
      },
      {
        "queue": "ncf-staging-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "max_concurrency": 8
      }
    ]
  },
  "triggers": { "crons": ["* * * * *"] },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    {
      "name": "EDGE_LIMITER",
      "namespace_id": "4001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "SHARE_PASSWORD_LIMITER",
      "namespace_id": "4002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SHARE_PASSWORD_IP_LIMITER",
      "namespace_id": "4003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_ORIGIN": "https://staging-app.darask.date",
    "CONTENT_ORIGIN": "https://staging-content.darask.date",
    "JOBS_QUEUE_NAME": "ncf-staging-jobs",
    "JOBS_DLQ_NAME": "ncf-staging-jobs-dlq",
    "PBKDF2_ITERATIONS": "100000",
    "EPOCH_FLOOR": "2",
    "STAGING_CONTROL_OPERATOR_ENABLED": "false",
    "BACKUP_OPERATOR_ENABLED": "false",
    "CLIENT_ENCRYPTION_REQUIRED": "true"
  },
  "secrets": {
    "required": [
      "ACCESS_ISSUER",
      "ACCESS_USER_AUDIENCE",
      "ACCESS_SERVICE_AUDIENCE",
      "BOOTSTRAP_OWNER_EMAILS",
      "BOOTSTRAP_OWNER_IDENTITIES",
      "BOOTSTRAP_QUOTA_BYTES",
      "CSRF_PRIVATE_KEYS",
      "CSRF_PUBLIC_KEYS",
      "CSRF_PRIVATE_ACTIVE_KID",
      "CSRF_PUBLIC_ACTIVE_KID",
      "CONTENT_TICKET_KEYS",
      "CONTENT_COOKIE_KEYS",
      "CONTENT_TICKET_ACTIVE_KID",
      "CONTENT_COOKIE_ACTIVE_KID",
      "NODE_CURSOR_KEYS",
      "NODE_CURSOR_ACTIVE_KID",
      "APP_PASSWORD_PEPPERS",
      "APP_PASSWORD_ACTIVE_KID",
      "SHARE_PASSWORD_PEPPERS",
      "SHARE_PASSWORD_ACTIVE_KID",
      "UPLOAD_CAPABILITY_KEYS",
      "UPLOAD_CAPABILITY_ACTIVE_KID",
      "R2_INVENTORY_ACCOUNT_ID",
      "R2_INVENTORY_BUCKET",
      "R2_INVENTORY_ACCESS_KEY_ID",
      "R2_INVENTORY_SECRET_ACCESS_KEY"
    ]
  }
}
