{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ncf-staging-backup-bridge",
  "main": "./backup-cron.mjs",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "services": [
    {
      "binding": "BACKUP_CONTROL",
      "service": "next-cloud-flare-staging",
      "entrypoint": "BackupOperator",
      "props": { "purpose": "logical-backup-v1", "environment": "staging" }
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "BACKUP_CRON_ENABLED": "true",
    "BACKUP_TARGET": "next-cloud-flare-staging",
    "BACKUP_EPOCH": "2",
    "BACKUP_ID": "REPLACE_WITH_BACKUP_UUID",
    "BACKUP_OPERATION": "REPLACE_WITH_OPERATION",
    "BACKUP_MANIFEST_SHA256": "REPLACE_WITH_MANIFEST_SHA256"
  }
}
