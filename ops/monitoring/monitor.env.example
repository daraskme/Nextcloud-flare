# Optional environment file for the local monitor user service.
# Protect the installed file with mode 0600. These values are never logged/notified.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Same exact storage settings as the weekly runner; absent settings leave backup health unknown.
NCF_BACKUP_MOUNT_POINT=
NCF_BACKUP_VOLUME_UUID=
NCF_BACKUP_EXTERNAL_ROOT=
